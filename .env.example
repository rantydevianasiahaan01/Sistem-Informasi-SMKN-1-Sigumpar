# ============================================================
# .env — dibaca docker-compose.yml (stack auth-service, tanpa Keycloak)
# ============================================================

# ----- GATEWAY / DOMAIN -----
# Produksi: APP_DOMAIN=smkn1sigumpar.sch.id, COOKIE_SECURE=true, API_GATEWAY_PORT=8201
# Lokal:    APP_DOMAIN=localhost, COOKIE_SECURE=false, API_GATEWAY_PORT=8001
API_GATEWAY_PORT=8001
APP_DOMAIN=localhost
COOKIE_SECURE=false

# URL API frontend (build). Di browser diganti window.location.origin.
VITE_API_URL=http://localhost:8001

# ----- SERVICE URL (antar container) -----
AUTH_SERVICE_URL=http://external-pkm-smkn1-sigumpar-auth-service:3005
ACADEMIC_SERVICE_URL=http://external-pkm-smkn1-sigumpar-academic-service:3003

# ----- AUTH (akun tata usaha awal) -----
ADMIN_AWAL_USERNAME=admin
ADMIN_AWAL_PASSWORD=admin12345
ADMIN_AWAL_NAMA=Administrator Tata Usaha

# ----- AUTH — JWT -----
JWT_ISSUER=smk-sigumpar
JWT_AUDIENCE=smk-sigumpar
JWT_TTL_DETIK=900
REFRESH_TTL_HARI=7

# ----- DATABASE — satu PostgreSQL untuk semua service -----
# WAJIB untuk docker compose: DB_HOST = nama container db (bukan localhost).
# localhost di dalam container = container itu sendiri → service stuck waiting.
# npm lokal ke Postgres compose: DB_HOST=localhost dan DB_PORT=5433
DB_NAME=pkm_smkn1sigumpar
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=external-pkm-smkn1-sigumpar-db
DB_PORT=5432
# Port di sisi host untuk pgAdmin/DBeaver
DB_PORT_HOST=5433
